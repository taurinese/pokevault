{
  "name": "@pokevault/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "rolldown src/index.ts --format esm --platform node --file dist/index.mjs",
    "start": "node dist/index.mjs",
    "sync:catalog": "node src/sync-catalog.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pokevault/domain": "workspace:*",
    "@pokevault/services": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "rolldown": "^1.3.3"
  }
}
