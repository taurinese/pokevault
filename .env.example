# =============================================================================
# PokéVault — environment template for self-host (docs/06-securite.md §5)
#
#   cp .env.example .env     # then fill every CHANGE_ME_* placeholder
#   docker compose up -d
#
# `.env` is gitignored: zero secret is ever committed.
# Sanity-check the stack without real secrets:
#   docker compose --env-file .env.example config
# =============================================================================

# --- Reverse proxy (Caddy) ----------------------------------------------------
# ":80" for local HTTP-only, or your domain for automatic HTTPS (Let's Encrypt).
CADDY_SITE_ADDRESS=:80

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Supabase Auth (GoTrue) ---------------------------------------------------
# Random 32+ char secret used to sign every JWT (HS256).
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET, payload
# {"role": "anon" | "service_role", "iss": "supabase", "iat": ..., "exp": ...}.
# Generate them at https://jwt.io (HS256, secret = JWT_SECRET) or with the
# Supabase CLI (`supabase start` prints local dev keys).
ANON_KEY=CHANGE_ME_ANON_KEY_JWT
SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY_JWT

# Public base URLs — what browsers see, through Caddy.
SITE_URL=http://localhost:80
API_EXTERNAL_URL=http://localhost:80
ADDITIONAL_REDIRECT_URLS=http://localhost:80

# Invite-only mode (docs/06-securite.md §1): true blocks new signups.
GOTRUE_DISABLE_SIGNUP=false

# --- OAuth providers (docs/04-integrations.md) --------------------------------
# Google
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOTRUE_EXTERNAL_GOOGLE_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
# Discord
GOTRUE_EXTERNAL_DISCORD_ENABLED=false
GOTRUE_EXTERNAL_DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
GOTRUE_EXTERNAL_DISCORD_SECRET=CHANGE_ME_DISCORD_CLIENT_SECRET

# --- Worker -------------------------------------------------------------------
# Delay between two heartbeat ticks, in milliseconds (strictly positive).
WORKER_HEARTBEAT_INTERVAL_MS=30000
