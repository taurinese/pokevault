# =============================================================================
# PokéVault — environment template for self-host (docs/06-securite.md §5)
#
#   cp .env.example .env     # then replace EVERY CHANGE_ME_* placeholder
#   docker compose up -d
#
# !!! WARNING !!! Every value starting with CHANGE_ME_ is a PLACEHOLDER, not a
# secret. Never deploy with it: the stack would boot with publicly known
# credentials. Generate a unique value for each one (commands below).
#
# `.env` is gitignored: zero secret is ever committed.
# Sanity-check the stack without real secrets:
#   docker compose --env-file .env.example config
# =============================================================================

# --- Reverse proxy (Caddy) ----------------------------------------------------
# ":80" for local HTTP-only, or your domain for automatic HTTPS (Let's Encrypt).
CADDY_SITE_ADDRESS=:80
# Host ports published by Caddy (change if 80/443 are already taken).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# Image tag for ghcr.io/taurinese/pokevault-{web,worker} (default: latest).
# POKEVAULT_TAG=latest

# --- Postgres -----------------------------------------------------------------
# POSTGRES_USER is intentionally NOT configurable: supabase/postgres boots with
# its own `supabase_admin` superuser; each service then uses a dedicated role
# (supabase_auth_admin, supabase_storage_admin, postgres) sharing this password.
POSTGRES_DB=postgres
# Generate with: openssl rand -hex 32
# (hex only: characters like / + @ # would break the postgres:// URLs)
# Set it BEFORE the first `docker compose up`: it is baked into the database.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Supabase Auth (GoTrue) ---------------------------------------------------
# Random secret (32+ chars) used to sign every JWT (HS256).
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET (HS256), payload
# {"role": "anon" | "service_role", "iss": "supabase", "iat": ..., "exp": ...}.
# Generate them at https://jwt.io (HS256, secret = JWT_SECRET) or with the
# Supabase CLI (`supabase start` prints local dev keys).
# SERVICE_ROLE_KEY bypasses RLS: it is given to the worker only, never to web.
ANON_KEY=CHANGE_ME_ANON_KEY_JWT
SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY_JWT

# Public base URLs — what browsers see, through Caddy (no trailing slash).
SITE_URL=http://localhost
API_EXTERNAL_URL=http://localhost
ADDITIONAL_REDIRECT_URLS=http://localhost

# Invite-only mode (docs/06-securite.md §1): true blocks new signups.
# Keep `true` by default. Set to `false` temporarily to let the initial
# accounts sign in with OAuth, then set it back to `true` and restart `auth`.
# With `false`, the DB allowlist (public.allowed_users, migration 001) still
# rejects every e-mail that is not invited: GoTrue creates no account for it.
# Linking a second provider (Google <-> Discord, screen 09B) is always allowed
# for a signed-in user and works with either value: it never creates a user.
# (docker-compose*.yml set GOTRUE_SECURITY_MANUAL_LINKING_ENABLED=true for it.)
GOTRUE_DISABLE_SIGNUP=true

# --- OAuth providers (docs/04-integrations.md) --------------------------------
# OAuth is the only login method (email, phone and anonymous logins are
# disabled in docker-compose.yml). Redirect URI to register at each provider:
#   ${API_EXTERNAL_URL}/auth/v1/callback
# Google
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOTRUE_EXTERNAL_GOOGLE_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
# Discord
GOTRUE_EXTERNAL_DISCORD_ENABLED=false
GOTRUE_EXTERNAL_DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
GOTRUE_EXTERNAL_DISCORD_SECRET=CHANGE_ME_DISCORD_CLIENT_SECRET

# --- Dev only (docker-compose.dev.yml) ----------------------------------------
# `pnpm dev` runs on http://localhost:3000 and reaches Supabase through the dev
# Caddy on http://localhost:54321 (/auth/v1/*, /storage/v1/*). Defaults shown;
# uncomment to override. Production values above are ignored by the dev stack.
# DEV_SITE_URL=http://localhost:3000
# DEV_API_EXTERNAL_URL=http://localhost:54321
# DEV_ADDITIONAL_REDIRECT_URLS=http://localhost:3000
# Catalogue search (/api/catalog/*, read-only SELECT, server-side only). Compose sets
# it automatically for the `web` service; for `pnpm dev` point it at the dev Postgres.
# Left unset, the catalogue routes answer an empty payload (with a logged warning).
# DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:54322/postgres

# --- Worker -------------------------------------------------------------------
# Delay between two heartbeat ticks, in milliseconds (strictly positive).
WORKER_HEARTBEAT_INTERVAL_MS=30000
