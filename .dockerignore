# VCS & CI
.git
.gitignore
.github

# Dependencies & build outputs (everything is rebuilt inside the image)
node_modules
**/node_modules
**/dist
**/.output
**/.vinxi
**/.tanstack
**/.vite
**/coverage
**/*.tsbuildinfo

# Environment & secrets (never bake secrets into an image)
.env
.env.*
!.env.example

# Docs & local-only tooling (not needed by the builder)
docs
infra
supabase
*.md

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.dev.yml

# Logs & OS
*.log
.DS_Store
Thumbs.db
